  "system_id": "HPS-SERIES-60KW",
  "metadata": {
    "name": "60kW Series Hybrid Range-Extender System — Fixed Wing MALE UAV",
    "architecture_type": "series",
    "platform_class": "fixed_wing",
    "design_mission": "24-hour ISTAR mission at 3000m, 120 ktas cruise, loiter capable",
    "certification_basis": "DGCA RPAS Category Specific / STANAG 4703",
    "revision": "A1",
    "last_updated": "2026-07-01",
    "design_authority": "Trinetra Aerospace Technologies"
  },

  "architecture": {
    "type": "series",
    "power_flow_description": "Micro-turboshaft (MICRO-TS-60) drives PMSG generator. Generator output rectified to 270V DC bus. Bus feeds: (1) PMSM propulsion motor via inverter, (2) battery pack for buffering/peak shaving. Battery also provides electric-only operation during startup, low-power loiter, and engine-off stealth segments. No mechanical path between turboshaft and propeller.",
    "thermal_count": 1,
    "generator_count": 1,
    "motor_count": 1,
    "battery_pack_count": 2,
    "power_bus_topology": "single_bus",
    "redundancy_level": "partial",
    "failure_modes": [
      {
        "failure": "Turboshaft flame-out",
        "effect": "Generator drops offline; battery supplies motor only",
        "mitigation": "Battery provides 15 min emergency endurance; automatic in-flight restart attempted once"
      },
      {
        "failure": "Generator failure",
        "effect": "Same as flame-out from bus perspective",
        "mitigation": "Battery reserve; return-to-home mode engaged"
      },
      {
        "failure": "Battery pack 1 fault",
        "effect": "50% battery power reduction; derates peak power",
        "mitigation": "Pack 2 continues; mission continues at reduced tempo"
      },
      {
        "failure": "Motor inverter fault",
        "effect": "Total propulsion loss",
        "mitigation": "Glide ratio permits controlled descent; auto-land mode"
      }
    ],
    "block_diagram_notes": "MICRO-TS-60 → [shaft] → PMSG-60kW → [AC 3-phase] → Rectifier → [270V DC bus] → Inverter → PMSM-60kW → [shaft] → Propeller. Battery packs connect directly to 270V DC bus via bidirectional DC-DC or direct switched connection."
  },

