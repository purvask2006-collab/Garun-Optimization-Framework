{
  "mission_id": "recon",
  "mission_name": "Fast Reconnaissance",
  "description": "High-tempo point reconnaissance: rapid ingress, multiple short low-altitude passes over discrete targets, rapid egress. Prioritizes speed and minimal exposure time over endurance.",
  "schema_version": "1.0",
  "compatible_engines": ["mission_simulator.py", "optimizer_mdo.py", "rl_balancing.py"],
  "aircraft_reference": {
    "mtow_kg": 1000,
    "engine_rating_kw": 60
  },
  "payload": {
    "type": "EO/IR gimbal + signals intelligence pod",
    "mass_kg": 150
  },
  "weather": {
    "condition": "partly cloudy",
    "wind_speed_mps": 10,
    "wind_direction_deg": 200,
    "temperature_c": 20,
    "visibility_km": 8,
    "icing_risk": "none"
  },
  "reserves": {
    "fuel_reserve_pct": 18,
    "battery_soc_reserve_pct": 25,
    "contingency_time_min": 15
  },
  "phases": [
    {
      "phase_id": 1,
      "phase_name": "Takeoff",
      "altitude_m": {"start": 0, "end": 50},
      "duration_s": 60,
      "power_kw": 60,
      "speed_mps": {"start": 0, "end": 25},
      "climb_rate_mps": 0.8,
      "power_source_hint": "engine_primary_battery_assist",
      "notes": "Max power phase."
    },
    {
      "phase_id": 2,
      "phase_name": "Climb",
      "altitude_m": {"start": 50, "end": 1500},
      "duration_s": 300,
      "power_kw": 57,
      "speed_mps": {"start": 25, "end": 60},
      "climb_rate_mps": 4.8,
      "power_source_hint": "engine_primary",
      "notes": "Lower cruise altitude than surveillance mission to enable fast, low-level passes."
    },
    {
      "phase_id": 3,
      "phase_name": "Ingress (High-Speed Transit)",
      "altitude_m": {"start": 1500, "end": 1500},
      "duration_s": 900,
      "power_kw": 58,
      "speed_mps": {"start": 70, "end": 70},
      "climb_rate_mps": 0,
      "power_source_hint": "engine_primary_battery_assist",
      "notes": "Near-max cruise speed to minimize exposure time en route."
    },
    {
      "phase_id": 4,
      "phase_name": "Recon Pass 1",
      "altitude_m": {"start": 1500, "end": 500},
      "duration_s": 300,
      "power_kw": 45,
      "speed_mps": {"start": 50, "end": 50},
      "climb_rate_mps": -3.3,
      "power_source_hint": "battery_primary",
      "notes": "Low-altitude descent pass over first target; battery-only for reduced acoustic/thermal signature."
    },
    {
      "phase_id": 5,
      "phase_name": "Reposition Climb",
      "altitude_m": {"start": 500, "end": 1500},
      "duration_s": 240,
      "power_kw": 55,
      "speed_mps": {"start": 55, "end": 65},
      "climb_rate_mps": 4.2,
      "power_source_hint": "engine_primary",
      "notes": "Climb back to transit altitude and reposition to second target."
    },
    {
      "phase_id": 6,
      "phase_name": "Recon Pass 2",
      "altitude_m": {"start": 1500, "end": 500},
      "duration_s": 300,
      "power_kw": 45,
      "speed_mps": {"start": 50, "end": 50},
      "climb_rate_mps": -3.3,
      "power_source_hint": "battery_primary",
      "notes": "Second low-altitude pass, battery-only."
    },
    {
      "phase_id": 7,
      "phase_name": "Egress (High-Speed Transit)",
      "altitude_m": {"start": 500, "end": 1500},
      "duration_s": 900,
      "power_kw": 58,
      "speed_mps": {"start": 70, "end": 70},
      "climb_rate_mps": 0,
      "power_source_hint": "engine_primary_battery_assist",
      "notes": "Rapid return transit."
    },
    {
      "phase_id": 8,
      "phase_name": "Descent",
      "altitude_m": {"start": 1500, "end": 50},
      "duration_s": 300,
      "power_kw": 15,
      "speed_mps": {"start": 45, "end": 30},
      "climb_rate_mps": -4.8,
      "power_source_hint": "battery_primary",
      "notes": "Low-power descent."
    },
    {
      "phase_id": 9,
      "phase_name": "Landing",
      "altitude_m": {"start": 50, "end": 0},
      "duration_s": 90,
      "power_kw": 20,
      "speed_mps": {"start": 30, "end": 0},
      "climb_rate_mps": -0.5,
      "power_source_hint": "battery_primary_engine_assist",
      "notes": "Approach and touchdown."
    }
  ]
}
