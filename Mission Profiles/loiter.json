{
  "mission_id": "loiter",
  "mission_name": "Maximum-Endurance Loiter Benchmark",
  "description": "Minimal-transit endurance test: climb directly overhead, hold a single extended low-power loiter, land. Used as the benchmark case for endurance comparisons (e.g., against the 6.5/7.1/7.7 hr table in the proposal), not a realistic operational mission.",
  "schema_version": "1.0",
  "compatible_engines": ["mission_simulator.py", "optimizer_mdo.py", "rl_balancing.py"],
  "aircraft_reference": {
    "mtow_kg": 1000,
    "engine_rating_kw": 60
  },
  "payload": {
    "type": "EO/IR camera + radar sensor suite",
    "mass_kg": 200
  },
  "weather": {
    "condition": "clear",
    "wind_speed_mps": 4,
    "wind_direction_deg": 0,
    "temperature_c": 15,
    "visibility_km": 15,
    "icing_risk": "none"
  },
  "reserves": {
    "fuel_reserve_pct": 15,
    "battery_soc_reserve_pct": 20,
    "contingency_time_min": 20
  },
  "phases": [
    {
      "phase_id": 1,
      "phase_name": "Takeoff",
      "altitude_m": {"start": 0, "end": 50},
      "duration_s": 60,
      "power_kw": 60,
      "speed_mps": {"start": 0, "end": 25},
      "climb_rate_mps": 0.8,
      "power_source_hint": "engine_primary_battery_assist",
      "notes": "Identical to surveillance mission takeoff for apples-to-apples benchmarking."
    },
    {
      "phase_id": 2,
      "phase_name": "Climb",
      "altitude_m": {"start": 50, "end": 3000},
      "duration_s": 600,
      "power_kw": 55,
      "speed_mps": {"start": 25, "end": 45},
      "climb_rate_mps": 4.9,
      "power_source_hint": "engine_primary",
      "notes": "Direct climb overhead the airfield."
    },
    {
      "phase_id": 3,
      "phase_name": "Extended Loiter",
      "altitude_m": {"start": 3000, "end": 3000},
      "duration_s": null,
      "power_kw": 28,
      "speed_mps": {"start": 35, "end": 35},
      "climb_rate_mps": 0,
      "power_source_hint": "battery_primary_engine_charging",
      "notes": "duration_s intentionally null: this is the free variable the simulation solves for to report max endurance. Simulator should run this phase until fuel_reserve_pct or battery_soc_reserve_pct floor is reached."
    },
    {
      "phase_id": 4,
      "phase_name": "Descent",
      "altitude_m": {"start": 3000, "end": 50},
      "duration_s": 480,
      "power_kw": 15,
      "speed_mps": {"start": 45, "end": 30},
      "climb_rate_mps": -6.1,
      "power_source_hint": "battery_primary",
      "notes": "Low-power descent."
    },
    {
      "phase_id": 5,
      "phase_name": "Landing",
      "altitude_m": {"start": 50, "end": 0},
      "duration_s": 90,
      "power_kw": 20,
      "speed_mps": {"start": 30, "end": 0},
      "climb_rate_mps": -0.5,
      "power_source_hint": "battery_primary_engine_assist",
      "notes": "Approach and touchdown."
    }
  ]
}
