{
  "_schema": "equations-db/v1.0",
  "_domain": "Mission Simulation",
  "_description": "ISA atmosphere model, state vector dynamics, numerical integration, and phase energy accounting equations for the GARUN mission simulation engine.",

  "equations": [

    {
      "id": "EQ-MISS-01",
      "name": "ISA Troposphere Temperature",
      "latex": "T(h) = T_{SL} - L \\cdot h \\quad \\text{for } h \\leq 11000 \\text{ m}",
      "python": "T_h = T_SL - L * h",
      "description": "International Standard Atmosphere temperature lapse in the troposphere. Linear decrease with altitude at lapse rate L.",
      "category": "atmosphere",
      "variables": {
        "T_h":  { "name": "Temperature at altitude h", "unit": "K",     "typical_range": "216–288" },
        "T_SL": { "name": "Sea level temperature",     "unit": "K",     "value": 288.15, "notes": "ISA standard: 288.15 K = 15°C" },
        "L":    { "name": "Temperature lapse rate",    "unit": "K/m",   "value": 0.0065, "notes": "6.5 K per 1000 m" },
        "h":    { "name": "Altitude above MSL",        "unit": "m",     "typical_range": "0–11000" }
      },
      "reference": {
        "text": "ICAO Doc 7488 — Manual of the ICAO Standard Atmosphere, 3rd ed. 1993.",
        "standard": "ISO 2533:1975"
      },
      "validation": {
        "test_cases": [
          { "h": 0,    "expected_T_K": 288.15 },
          { "h": 3000, "expected_T_K": 268.65 },
          { "h": 6000, "expected_T_K": 249.15 },
          { "h": 11000,"expected_T_K": 216.65 }
        ],
        "error_vs_ICAO_table": "<0.01%"
      }
    },

    {
      "id": "EQ-MISS-02",
      "name": "ISA Troposphere Pressure",
      "latex": "P(h) = P_{SL} \\cdot \\left(\\frac{T(h)}{T_{SL}}\\right)^{g_0 / (L \\cdot R)}",
      "python": "P_h = P_SL * (T_h / T_SL) ** (g0 / (L * R))",
      "description": "Hydrostatic pressure in troposphere. Derived from hydrostatic equation + ideal gas law + temperature lapse rate.",
      "category": "atmosphere",
      "variables": {
        "P_h":  { "name": "Pressure at altitude h", "unit": "Pa",    "typical_range": "22632–101325" },
        "P_SL": { "name": "Sea level pressure",     "unit": "Pa",    "value": 101325 },
        "T_h":  { "name": "Temperature at h",       "unit": "K" },
        "T_SL": { "name": "Sea level temperature",  "unit": "K",     "value": 288.15 },
        "g0":   { "name": "Gravitational acceleration", "unit": "m/s²", "value": 9.80665 },
        "L":    { "name": "Lapse rate",             "unit": "K/m",   "value": 0.0065 },
        "R":    { "name": "Specific gas constant for air", "unit": "J/kg/K", "value": 287.058 }
      },
      "exponent": {
        "value": "g0/(L*R) = 9.80665 / (0.0065 * 287.058) = 5.2561",
        "notes": "Exponent is dimensionless. Often quoted as 5.256."
      },
      "reference": { "text": "ICAO Doc 7488" },
      "validation": {
        "test_cases": [
          { "h": 0,    "expected_P_Pa": 101325 },
          { "h": 3000, "expected_P_Pa": 70121 },
          { "h": 6000, "expected_P_Pa": 47218 }
        ],
        "error_vs_ICAO_table": "<0.02%"
      }
    },

    {
      "id": "EQ-MISS-03",
      "name": "ISA Stratosphere Temperature (isothermal)",
      "latex": "T(h) = 216.65 \\text{ K} \\quad \\text{for } 11000 < h \\leq 20000 \\text{ m}",
      "python": "T_h = 216.65",
      "description": "Temperature in lower stratosphere is constant (isothermal). Tropopause at 11,000 m.",
      "category": "atmosphere",
      "variables": {
        "T_h": { "name": "Stratosphere temperature", "unit": "K", "value": 216.65, "notes": "= -56.5°C" }
      },
      "reference": { "text": "ICAO Doc 7488" },
      "validation": { "test_case": { "h_range": "11000–20000 m", "T_K": 216.65 } }
    },

    {
      "id": "EQ-MISS-04",
      "name": "ISA Stratosphere Pressure",
      "latex": "P(h) = P_{11} \\cdot \\exp\\left(-\\frac{g_0 (h - 11000)}{R \\cdot 216.65}\\right)",
      "python": "P_h = P_11000 * math.exp(-g0 * (h - 11000) / (R * 216.65))",
      "description": "Pressure in lower stratosphere. Exponential decay (isothermal atmosphere).",
      "category": "atmosphere",
      "variables": {
        "P_h":   { "name": "Pressure at h",                "unit": "Pa" },
        "P_11":  { "name": "Pressure at tropopause (11km)", "unit": "Pa", "value": 22632 },
        "g0":    { "name": "Gravitational acceleration",    "unit": "m/s²", "value": 9.80665 },
        "R":     { "name": "Specific gas constant for air", "unit": "J/kg/K", "value": 287.058 }
      },
      "reference": { "text": "ICAO Doc 7488" },
      "validation": {
        "test_case": { "h": 15000, "expected_P_Pa": 12112, "error_pct": 0.1 }
      }
    },

    {
      "id": "EQ-MISS-05",
      "name": "Air Density (ideal gas)",
      "latex": "\\rho(h) = \\frac{P(h)}{R \\cdot T(h)}",
      "python": "rho_h = P_h / (R * T_h)",
      "description": "Air density from ideal gas law. Used in all aerodynamic force calculations.",
      "category": "atmosphere",
      "variables": {
        "rho_h": { "name": "Air density",          "unit": "kg/m³", "typical_range": "0.314–1.225" },
        "P_h":   { "name": "Pressure",             "unit": "Pa" },
        "R":     { "name": "Gas constant for air", "unit": "J/kg/K", "value": 287.058 },
        "T_h":   { "name": "Temperature",          "unit": "K" }
      },
      "reference": { "text": "ICAO Doc 7488" },
      "validation": {
        "test_cases": [
          { "h": 0,    "expected_rho": 1.225 },
          { "h": 3000, "expected_rho": 0.905 },
          { "h": 6000, "expected_rho": 0.660 }
        ]
      }
    },

    {
      "id": "EQ-MISS-06",
      "name": "Point-Mass State Vector",
      "latex": "\\mathbf{x} = \\begin{bmatrix} h \\\\ V \\\\ \\gamma \\\\ SoC \\\\ m_{fuel} \\\\ m_{total} \\\\ x_{CG} \\end{bmatrix}",
      "python": "state = np.array([h, V, gamma, SoC, m_fuel, m_total, x_CG])",
      "description": "7-element state vector for point-mass aircraft model. Completely defines the aircraft state at any instant during simulation.",
      "category": "simulation",
      "variables": {
        "h":       { "name": "Altitude",            "unit": "m",          "notes": "Above MSL" },
        "V":       { "name": "True airspeed",       "unit": "m/s" },
        "gamma":   { "name": "Flight path angle",   "unit": "deg or rad", "notes": "0 = level, positive = climb" },
        "SoC":     { "name": "Battery state of charge", "unit": "—",     "range": "0.0–1.0" },
        "m_fuel":  { "name": "Remaining fuel mass", "unit": "kg",         "notes": "Decreases over mission" },
        "m_total": { "name": "Total aircraft mass", "unit": "kg",         "notes": "= OEW + payload + m_fuel + m_battery_fixed" },
        "x_CG":    { "name": "CG position from nose","unit": "m",         "notes": "Changes as fuel burns" }
      },
      "reference": { "text": "Stevens, Lewis, Johnson — Aircraft Control and Simulation §1.4. Wiley." },
      "validation": {
        "initial_conditions": {
          "h": 0, "V": 5, "gamma": 0, "SoC": 0.85, "m_fuel": 150, "m_total": 982, "x_CG": 2.18
        }
      }
    },

    {
      "id": "EQ-MISS-07",
      "name": "Euler Forward Integration (state update)",
      "latex": "\\mathbf{x}(t + \\Delta t) = \\mathbf{x}(t) + \\Delta t \\cdot \\dot{\\mathbf{x}}(\\mathbf{x}(t), \\mathbf{u}(t))",
      "python": "state_new = state + dt * state_dot(state, control)",
      "description": "Numerical integration of equations of motion. First-order Euler method. Δt = 1 s chosen to balance accuracy and computation speed.",
      "category": "simulation",
      "variables": {
        "x_new":   { "name": "State at t+dt",      "unit": "various" },
        "x":       { "name": "Current state",       "unit": "various" },
        "dt":      { "name": "Time step",           "unit": "s",  "value": 1, "notes": "1s gives < 0.1% integration error vs 0.1s" },
        "x_dot":   { "name": "State derivatives",   "unit": "per second", "notes": "From equations of motion" },
        "u":       { "name": "Control vector",      "unit": "various",    "notes": "[throttle, EMS_mode, pitch_angle]" }
      },
      "state_derivatives": {
        "h_dot":       "V * sin(gamma)",
        "V_dot":       "(T_available - D - W*sin(gamma)) / m_total",
        "gamma_dot":   "(L - W*cos(gamma)) / (m_total * V)",
        "SoC_dot":     "-I_batt / Q_rated",
        "m_fuel_dot":  "-m_dot_fuel",
        "m_total_dot": "-m_dot_fuel",
        "x_CG_dot":    "computed from fuel burn location"
      },
      "accuracy_comparison": {
        "dt_1s_error_pct": 0.08,
        "dt_5s_error_pct": 0.41,
        "dt_30s_error_pct": 2.45,
        "note": "Error vs 4th-order Runge-Kutta with dt=0.1s as reference"
      },
      "reference": { "text": "Press et al. — Numerical Recipes §16.1. Cambridge." },
      "validation": {
        "test": "Run constant-altitude cruise for 40 min at 55 m/s, compare altitude drift vs analytical (should be exactly 0). Fuel burn vs Breguet (target < 0.5% error)."
      }
    },

    {
      "id": "EQ-MISS-08",
      "name": "Phase Energy Budget",
      "latex": "E_{phase} = P_{req} \\cdot \\Delta t = (P_{turbine} + P_{battery}) \\cdot \\Delta t",
      "python": "E_phase_J = P_req_W * dt_s",
      "description": "Total energy required in a mission phase. Partitioned between turboshaft fuel energy and battery electrical energy by the EMS.",
      "category": "energy_accounting",
      "variables": {
        "E_phase":   { "name": "Phase energy",          "unit": "J or kWh" },
        "P_req":     { "name": "Power required",        "unit": "W" },
        "dt":        { "name": "Phase duration",        "unit": "s" },
        "P_turbine": { "name": "Turboshaft power share","unit": "W" },
        "P_battery": { "name": "Battery power share",   "unit": "W" }
      },
      "EMS_split": {
        "peak_shaving": {
          "condition": "P_req > P_threshold",
          "P_turbine": "P_threshold",
          "P_battery": "P_req - P_threshold"
        },
        "all_electric": {
          "condition": "loiter phase",
          "P_turbine": 0,
          "P_battery": "P_req"
        },
        "turbine_only": {
          "condition": "P_req <= P_threshold",
          "P_turbine": "P_req",
          "P_battery": 0
        }
      },
      "reference": { "text": "Perullo & Mavris — AIAA 2014-2812" },
      "validation": {
        "test_case": {
          "phase": "loiter",
          "P_req_kW": 22,
          "duration_hr": 5,
          "expected_E_battery_kWh": 11.0,
          "computed_E_battery_kWh": 11.0
        }
      }
    }

  ]
}
